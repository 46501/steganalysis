# =============================================================================
# StegoShield AI — Backend Environment Configuration Template
# =============================================================================
# Copy this file to .env or backend/.env and update the values.
# NEVER commit actual passwords or database connection strings to Git!

# Environment Mode: 'development' (allows local SQLite fallback) or 'production' (strictly requires Neon PostgreSQL)
ENVIRONMENT=development

# Explicitly force local SQLite mode for development (default is False)
# USE_SQLITE=true

# Database Connections
# --------------------
# For Neon PostgreSQL: paste your connection string here.
# Both direct (ep-xyz.neon.tech) and pooled (ep-xyz-pooler.neon.tech) endpoints are supported.
# The backend automatically normalizes 'postgresql://' or 'postgres://' to 'postgresql+asyncpg://'.
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Synchronous connection string for Alembic migrations (optional, auto-derived if omitted):
# SYNC_DATABASE_URL="postgresql+psycopg2://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ML Device and Checkpoint Path
DEVICE="cpu"
SRNET_WEIGHTS_PATH="app/ml/weights/srnet_weights.pth"

# Authentication & Session Security (NIST SP 800-63B)
JWT_SECRET_KEY="stegoshield-super-secure-jwt-key-change-this-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false  # Set to true in production over HTTPS

# Rate Limiting Constraints
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=300
RATE_LIMIT_ANALYZE_PER_MINUTE=60

# Upload Constraints
MAX_UPLOAD_SIZE_MB=25

# CORS Allowed Origins (JSON array)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

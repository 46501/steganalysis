# Environment files
.env
.env.*
*.env
*.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# Secrets & Keys
*.pem
*.key
*.cert
*.crt
*.pfx
*.secret
secrets/

# Databases & Local storage
storage/*.db
backend/storage/*.db
*.sqlite
*.sqlite3

# Git & Caches
.git/
.pytest_cache/
__pycache__/
*.py[cod]
venv/
backend/venv/
node_modules/
frontend/node_modules/
frontend/dist/


# ── StegoVault Configuration Example ───────────────────────────────────────────
# Copy this file to .env or set environment variables in your deployment environment.

# ── Database Configuration ───────────────────────────────────────────────────
# Path to the SQLite database file. Defaults to 'stegovault.db' in the project root.
# Uses SQLite with WAL (Write-Ahead Logging) mode, foreign key enforcement, and indexes.
STEGOVAULT_DB_PATH=stegovault.db

# ── Session & Security ────────────────────────────────────────────────────────
# Set to 'production' in live deployments.
STEGOVAULT_ENV=development

# Enforce the 'Secure' flag on HttpOnly session cookies (1 for HTTPS/production, 0 for HTTP dev).
STEGOVAULT_COOKIE_SECURE=0

# Optional comma-separated list of extra Host headers allowed (beyond localhost/127.0.0.1/[::1])
# STEGOVAULT_ALLOWED_HOSTS=vault.example.com,internal.lan

# Optional shared API token for CLI / headless invocation (disabled by default)
# STEGOVAULT_WEB_TOKEN=auto

# ── Transactional Email (SMTP) ────────────────────────────────────────────────
# Configure your SMTP provider for real account verification & password reset emails.
# If omitted, StegoVault operates in development mode and logs verification/recovery links to stderr.
STEGOVAULT_SMTP_HOST=
STEGOVAULT_SMTP_PORT=587
STEGOVAULT_SMTP_USER=
STEGOVAULT_SMTP_PASS=
STEGOVAULT_SMTP_TLS=1
STEGOVAULT_SMTP_FROM="StegoVault Security <no-reply@stegovault.local>"

# ── Steganography Engine Upload Limits ────────────────────────────────────────
# Maximum carrier file upload size in bytes (default 200 MB = 209715200)
STEGOVAULT_MAX_UPLOAD_BYTES=209715200

# ==========================================
# Steganalysis Project .gitignore
# ==========================================

# Environments & Secret Configurations
.env
.env.local
.env.*.local
*.env
!.env.example
!backend/.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Model Checkpoints & Large Weights
*.pt
*.pth
*.ckpt
*.bin
*.onnx
*.h5
*.pb
*.tflite
backend/app/ml/weights/*
!backend/app/ml/weights/.gitkeep
backend/checkpoints/*
!backend/checkpoints/.gitkeep
backend/logs/*
!backend/logs/.gitkeep

# Dataset and Raw Images
dataset/
dataset/**
*.pgm
*.mat

# Temporary Storage & Uploads
storage/*
!storage/.gitkeep
backend/storage/*
!backend/storage/.gitkeep
uploads/
temp/
*.log

# Databases & Local persistence
*.sqlite
*.sqlite3
*.db
data/
postgres-data/

# Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.local

# Editors and Operating Systems
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
.DS_Store
Thumbs.db
Desktop.ini


# Backend Configuration
PROJECT_NAME="SRNet Steganalysis API"
API_V1_STR="/api/v1"
DEBUG=True

# Database Connections
# Async connection string for FastAPI
DATABASE_URL="postgresql+asyncpg://postgres:postgres_secure_password@localhost:5432/steganalysis"
# Synchronous connection string for Alembic migrations
SYNC_DATABASE_URL="postgresql+psycopg2://postgres:postgres_secure_password@localhost:5432/steganalysis"

# ML Device and Checkpoint Path
DEVICE="cpu"
SRNET_WEIGHTS_PATH="app/ml/weights/srnet_weights.pth"

# Upload and Security Constraints
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=["png", "bmp", "pgm", "jpg", "jpeg"]

# CORS Allowed Origins (JSON array)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

